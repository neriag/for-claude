# WhatsApp Mirror Bot Configuration
# Copy this file to .env and fill in your values

# Port for the Express server (default: 3000)
PORT=3000

# Your WhatsApp Cloud API access token
# Get this from: Meta Developer Console > Your App > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# Webhook verification token (you create this - any random string)
# Must match what you enter in Meta Developer Console webhook settings
VERIFY_TOKEN=your_random_verify_token_here

# OpenAI API key for audio transcription (Whisper)
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
